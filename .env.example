# Storage mode: "local" (default demo mode) | "api" (Vercel /api routes) | "supabase"
VITE_STORAGE_MODE=local

# Optional: Custom API base when using Vercel Serverless Functions
VITE_API_BASE_URL=/api

# Optional: Supabase client credentials (when connecting Supabase directly)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Server-side Postgres / Neon / Supabase connection string (set in Vercel Project Settings)
DATABASE_URL=
